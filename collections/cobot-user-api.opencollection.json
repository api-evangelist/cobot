{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cobot User API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://www.cobot.me/oauth/authorize",
      "accessTokenUrl": "https://www.cobot.me/oauth/access_token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cobot.me/user",
            "params": [
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "List of related resources to include in response. Provide a comma separated list of relationship names.\n`memberOf` and `adminOf` require the `read_spaces` scope.\n`memberships` requires the `read_memberships` scope.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://www.cobot.me/oauth/authorize",
              "accessTokenUrl": "https://www.cobot.me/oauth/access_token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "The `adminOf`/`membershipOf` relationships return the spaces that the user\nis an admin or member of.\n\nThe `memberships` relationship returns the actual membership data.\n"
        }
      ]
    }
  ],
  "bundled": true
}