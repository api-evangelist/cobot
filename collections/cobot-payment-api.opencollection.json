{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cobot Payment API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://www.cobot.me/oauth/authorize",
