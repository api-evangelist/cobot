{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cobot Product API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://www.cobot.me/oauth/authorize",
      "accessTokenUrl": "https://www.cobot.me/oauth/access_token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Product",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Single product",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cobot.me/products/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The id of the product."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://www.cobot.me/oauth/authorize",
              "accessTokenUrl": "https://www.cobot.me/oauth/access_token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "A single product.\n\n**Access**: Any user can view products.\n"
        },
        {
          "info": {
            "name": "List for space",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cobot.me/spaces/:spaceId/products",
            "params": [
              {
                "name": "spaceId",
                "value": "",
                "type": "path",
                "description": "The id of the space to get the products for."
              },
              {
                "name": "filter[scope]",
                "value": "",
                "type": "query",
                "description": "Only return products enabled for the given scopes.\nReturns products matching any of the provided scopes.\nReturns all products if no scope is provided.\n"
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Include product categories. The categories are returned in the order set up \nby admins, so should not be sorted again by the client.\n"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://www.cobot.me/oauth/authorize",
              "accessTokenUrl": "https://www.cobot.me/oauth/access_token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "List the products for a space. The products are returned in the order set up \nby admins, so should not be sorted again by the client.\n\n**Access**: Any user can view products.\n"
        }
      ]
    }
  ],
  "bundled": true
}