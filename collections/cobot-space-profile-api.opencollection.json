{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cobot Space Profile API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://www.cobot.me/oauth/authorize",
      "accessTokenUrl": "https://www.cobot.me/oauth/access_token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Space Profile",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a space profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cobot.me/space_profiles/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The id of the space profile."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://www.cobot.me/oauth/authorize",
              "accessTokenUrl": "https://www.cobot.me/oauth/access_token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "To obtain the link to a space profile, see the relationships of the corresponding space.\n\n**Access**: Any user can access any space's profile information.\n\nThe `location` attribute is a free-form string. When a structured address is\navailable, it is returned in the `structuredAddress` attribute.\n"
        }
      ]
    }
  ],
  "bundled": true
}