{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cobot Team API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://www.cobot.me/oauth/authorize",
      "accessTokenUrl": "https://www.cobot.me/oauth/access_token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Team",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "For space",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cobot.me/spaces/:spaceId/teams",
            "params": [
              {
                "name": "spaceId",
                "value": "",
                "type": "path",
                "description": "Id of the space."
              },
              {
                "name": "filter[from]",
                "value": "2020-04-20",
                "type": "query",
                "description": "Only return teams that have not been canceled or been canceled on or after the given date."
              },
              {
                "name": "filter[to]",
                "value": "2020-04-20",
                "type": "query",
                "description": "Only return teams that have been confirmed before or on the given date."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://www.cobot.me/oauth/authorize",
              "accessTokenUrl": "https://www.cobot.me/oauth/access_token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a list of teams for a space.\n\n**Access**: The current user must be an admin of the space.\n"
        },
        {
          "info": {
            "name": "Single Team",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.cobot.me/teams/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id of the team."
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "https://www.cobot.me/oauth/authorize",
              "accessTokenUrl": "https://www.cobot.me/oauth/access_token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get a single team.\n\n**Access**: The current user must be an admin of the space the team belongs to.\n"
        }
      ]
    }
  ],
  "bundled": true
}